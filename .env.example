# ---------------------------------------------------------------
# Copie este archivo como .env y ajuste los valores.
# El archivo .env NUNCA se debe subir al repositorio.
# ---------------------------------------------------------------

# --- Base de datos ---------------------------------------------
# sqlite (pruebas locales) | postgresql (producción)
DB_ENGINE=sqlite

# SQLite: ruta relativa a la raíz del proyecto
SQLITE_PATH=app.db

# PostgreSQL (requiere: uv sync --extra postgres)
DB_HOST=localhost
DB_PORT=5432
DB_NAME=today
DB_USER=today_app
DB_PASSWORD=cambie-esta-contraseña
# disable | require | verify-ca | verify-full (vacío = por defecto de libpq)
DB_SSLMODE=
# true para ver las consultas SQL en consola
DB_ECHO=false

# --- Secretos --------------------------------------------------
# Clave Fernet para cifrar PII/PHI, datos crediticios y semillas OTP.
# Generar con:
#   uv run python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# ¡Si se pierde, los datos cifrados no se pueden recuperar!
ENCRYPTION_KEY=

# --- OTP -------------------------------------------------------
OTP_ISSUER=domain.lat
# Pasos de 30 s tolerados antes/después (desfase de reloj)
OTP_VALID_WINDOW=1

# --- Rate limiting ---------------------------------------------
MAX_LOGIN_ATTEMPTS=5
LOCKOUT_MINUTES=15
