# ---------------------------------------------------------------
# Copie este archivo como .env y ajuste los valores.
# El archivo .env NUNCA se debe subir al repositorio.
# (También puede poner estas mismas claves en .streamlit/secrets.toml)
# ---------------------------------------------------------------

# --- Base de datos ---------------------------------------------
# sqlite (pruebas locales) | postgresql (AWS)
DB_ENGINE=postgresql

# SQLite: ruta relativa a la raíz del proyecto (solo si DB_ENGINE=sqlite)
SQLITE_PATH=app.db

# PostgreSQL en la instancia "base-de-datos" (IP privada, sin IP pública)
DB_HOST=192.168.101.103
DB_PORT=5432
DB_NAME=ciber_bleyk
DB_USER=analyst_3
# Use comillas simples si la contraseña tiene $, ; o #
DB_PASSWORD=''
# disable | require | verify-ca | verify-full (vacío = por defecto de libpq)
DB_SSLMODE=
# Segundos de espera antes de dar timeout (SSH y PostgreSQL)
DB_CONNECT_TIMEOUT=10
# true para ver las consultas SQL en consola
DB_ECHO=false

# --- Túnel SSH -------------------------------------------------
# true  = la app corre en su PC: túnel por el servidor web vía Tailscale
# false = la app corre en el servidor web: conexión directa a DB_HOST
DB_USE_TUNNEL=true
SSH_HOST=webserver.taild46e50.ts.net
SSH_PORT=22
SSH_USER=dbtunnel
# Ruta a la clave privada (NO la copie dentro del repositorio)
SSH_KEY_PATH=C:\Users\<usuario>\Desktop\ciber\analyst_3\analyst_3
# Puerto local del túnel (0 = uno libre automáticamente)
SSH_LOCAL_PORT=0

# --- Secretos --------------------------------------------------
# Clave Fernet para cifrar PII/PHI, datos crediticios y semillas OTP.
# Generar con:
#   uv run python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# ¡Si se pierde, los datos cifrados no se pueden recuperar!
ENCRYPTION_KEY=

# --- OTP -------------------------------------------------------
OTP_ISSUER=domain.lat
# Pasos de 30 s tolerados antes/después (desfase de reloj)
OTP_VALID_WINDOW=1

# --- Rate limiting ---------------------------------------------
MAX_LOGIN_ATTEMPTS=5
LOCKOUT_MINUTES=15
